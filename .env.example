NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Set to true to skip Upstash entirely (local dev only).
# In shared/prod environments do not use memory KV, because room state must be shared across instances.
# KV_USE_MEMORY=true
# Fallback behavior when KV is configured but unreachable:
# default is enabled.
# Set explicitly to false to enforce strict remote-only KV behavior.
# KV_ALLOW_MEMORY_FALLBACK=true
# Multiplayer rollout flag: default disabled until solo flow is fully stable in production.
# TRIVIA_ENABLE_MULTIPLAYER=true
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_PLAYERS_SPREADSHEET_ID=
GOOGLE_SHEETS_QUESTIONS_SPREADSHEET_ID=
GOOGLE_SHEETS_MATCHES_SPREADSHEET_ID=
GOOGLE_SHEETS_MATCH_ANSWERS_SPREADSHEET_ID=
GOOGLE_SHEETS_LEADERBOARD_SPREADSHEET_ID=
GOOGLE_SHEETS_LEADERBOARD_SNAPSHOTS_SPREADSHEET_ID=
# Either provide the two vars below, or a full service account JSON / file path in GOOGLE_APPLICATION_CREDENTIALS
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
